DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/prosotapmo
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
# Google Maps Platform key for the 4D "Site Context" layer (Google
# Photorealistic 3D Tiles, embedded directly in the main viewport via
# 3d-tiles-renderer) — must have the Map Tiles API enabled and an
# HTTP-referrer restriction set in Google Cloud Console before this is
# used past local dev; served to the authenticated frontend as-is
# (site_context.py's GET /tiles-key), so an unrestricted key is usable by
# anyone who inspects network traffic. Editable from within the app itself
# (AppSettings, the Site Context panel's own API Key field) — this is only
# a fallback default for ops-managed deployments that prefer env vars.
GOOGLE_TILES_API_KEY=
