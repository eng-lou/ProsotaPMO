DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/prosotapmo
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
# Google Maps Platform key for the 4D "Site Context" layer (Google
# Photorealistic 3D Tiles, embedded directly in the main viewport via
# 3d-tiles-renderer) — must have the Map Tiles API enabled and an
# HTTP-referrer restriction set in Google Cloud Console before this is
# used past local dev; served to the authenticated frontend as-is
# (site_context.py's GET /tiles-key), so an unrestricted key is usable by
# anyone who inspects network traffic. Editable from within the app itself
# (AppSettings, the Site Context panel's own API Key field) — this is only
# a fallback default for ops-managed deployments that prefer env vars.
GOOGLE_TILES_API_KEY=
# Cloudflare R2 (2026-08-23) — required for every file upload (IFC/GLTF/
# OBJ/FBX imports, Site Captures, 4D video exports): Vercel Functions
# hard-cap request bodies at 4.5MB, so uploads go straight from the browser
# to R2 instead of through this backend (see app/services/object_storage.py's
# own header). No local-disk fallback — local dev needs these set too,
# same R2 bucket as production or a separate one, either works.
# r2_account_id is your Cloudflare account ID; access_key_id/secret come
# from an R2 API token (Cloudflare dashboard -> R2 -> Manage R2 API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=prosota-pmo
# Project Controls Assistant (2026-08-31) — an Anthropic API key
# (console.anthropic.com), required for POST /api/v1/ai/chat to work at
# all; that endpoint 503s with a clear message rather than failing
# silently when this is unset (see app/ai/client.py).
ANTHROPIC_API_KEY=
