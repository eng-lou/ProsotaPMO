{
  "name": "prosota-desktop",
  "productName": "Prosota Planner",
  "version": "0.2.42",
  "releaseChannel": "preview",
  "private": true,
  "description": "Prosota Planner for Windows",
  "author": "Prosota",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "node ../frontend/node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "start": "electron .",
    "package": "electron-builder --win nsis --x64",
    "package:preview": "node package-channel.cjs preview",
    "package:stable": "node package-channel.cjs stable",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.prosota.desktop.preview",
    "productName": "Prosota Planner Preview",
    "executableName": "Prosota Desktop Preview",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "auth.cjs",
      "preload.cjs",
      "settings.cjs",
      "provider-links.cjs",
      "release-channel.cjs",
      "powerbi.cjs",
      "package.json",
      "assets/prosota.ico"
    ],
    "extraResources": [
      {
        "from": "powerbi-template",
        "to": "powerbi-template",
        "filter": [
          "**/*",
          "!**/.pbi/**"
        ]
      },
      {
        "from": "dist",
        "to": "ui"
      },
      {
        "from": "runtime/backend",
        "to": "backend"
      },
      {
        "from": "runtime/postgres",
        "to": "postgres"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/prosota.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Prosota-Desktop-Preview-${version}-Setup.${ext}",
      "installerIcon": "assets/prosota.ico",
      "uninstallerIcon": "assets/prosota.ico"
    }
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  }
}
